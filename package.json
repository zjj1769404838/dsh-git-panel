{
  "name": "@zjj/dsh-git-panel",
  "version": "0.1.0",
  "description": "Git 账号接入与受控仓库操作：在 DSH 输入框下方左侧加入口，支持 OAuth 设备码与 PAT 两种接入方式，把仓库信息/分支/差异/提交记录与受控写操作封装成 Agent 工具，令牌永不明文回显。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "scripts": {
    "bundle": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gates": "node scripts/gates/run.mjs",
    "test:hardening": "node scripts/test-hardening.mjs",
    "preview": "node scripts/preview.mjs",
    "test:e2e": "node scripts/e2e-settings.mjs",
    "test": "node scripts/gates/run.mjs && node scripts/test-hardening.mjs",
    "test:e2e:wb": "node scripts/e2e-workbench.mjs",
    "test:e2e:newui": "node scripts/e2e-newui.mjs"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md",
    "LICENSE",
    "docs/*.md",
    "src"
  ],
  "license": "MIT",
  "author": "zjj1769404838 <1769404838@qq.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zjj1769404838/dsh-git-panel.git"
  },
  "homepage": "https://github.com/zjj1769404838/dsh-git-panel#readme",
  "bugs": {
    "url": "https://github.com/zjj1769404838/dsh-git-panel/issues"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "git",
    "oauth",
    "pat",
    "agent-tools"
  ],
  "engines": {
    "node": ">=18"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
