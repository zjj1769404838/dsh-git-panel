{
  "name": "@zjjlivingfree/dsh-git-panel",
  "version": "0.4.0",
  "description": "DSH Git 面板（v3 极简）：输入框旁 chip 展示仓库状态，动作按钮把 git 指令注入输入框交给 AI 经 git_write/git_confirm 受控执行；支持 GitHub OAuth 设备码与 PAT，令牌加密保存、永不明文回显。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "scripts": {
    "bundle": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gates": "node scripts/gates/run.mjs",
    "test:hardening": "node scripts/test-hardening.mjs",
    "test": "node scripts/gates/run.mjs && node scripts/test-hardening.mjs"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs/*.md",
    "src"
  ],
  "license": "MIT",
  "author": "zjj1769404838 <1769404838@qq.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zjj1769404838/dsh-git-panel.git"
  },
  "homepage": "https://github.com/zjj1769404838/dsh-git-panel#readme",
  "bugs": {
    "url": "https://github.com/zjj1769404838/dsh-git-panel/issues"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "git",
    "oauth",
    "pat",
    "agent-tools"
  ],
  "engines": {
    "node": ">=18"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {}
}
